{
	"name": "frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=18.0.0",
		"npm": "^10.0.0"
	},
	"scripts": {
		"dev": "vite dev --host 0.0.0.0",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:integration && npm run test:unit",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"lint:check": "npm-run-all --parallel lint:check:**",
		"lint:check:svelte": "svelte-check --fail-on-warnings",
		"lint:check:ts": "tsc --noEmit",
		"lint:check:eslint": "eslint --cache --max-warnings 0 src",
		"lint:fix": "eslint --cache --fix src"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.2.0",
		"@eslint/js": "^9.17.0",
		"@iconify-json/heroicons": "1.2.2",
		"@sveltejs/adapter-static": "3.0.8",
		"@sveltejs/kit": "2.15.1",
		"@sveltejs/vite-plugin-svelte": "3.1.2",
		"@testing-library/jest-dom": "6.6.3",
		"@testing-library/svelte": "4.2.3",
		"@typescript-eslint/eslint-plugin": "8.18.1",
		"@typescript-eslint/parser": "8.18.1",
		"@vitest/coverage-istanbul": "1.6.0",
		"autoprefixer": "10.4.20",
		"eslint": "9.17.0",
		"eslint-config-prettier": "9.1.0",
		"eslint-plugin-jest": "28.10.0",
		"eslint-plugin-svelte": "2.46.1",
		"@vitest/eslint-plugin": "1.1.24",
		"globals": "^15.14.0",
		"jsdom": "24.1.3",
		"npm-run-all": "4.1.5",
		"postcss": "8.4.49",
		"postcss-load-config": "5.1.0",
		"prettier": "3.4.2",
		"prettier-plugin-svelte": "3.3.2",
		"prettier-plugin-tailwindcss": "0.6.9",
		"svelte": "4.2.19",
		"svelte-check": "3.8.6",
		"svelte-eslint-parser": "0.43.0",
		"svelte-preprocess": "6.0.3",
		"tailwindcss": "3.4.17",
		"tslib": "2.8.1",
		"tw-colors": "3.3.2",
		"typescript": "5.7.2",
		"unplugin-icons": "0.22.0",
		"vite": "5.4.11",
		"vitest": "1.6.0"
	},
	"dependencies": {
		"@sentry/sveltekit": "7.120.2",
		"@types/leaflet": "1.9.15",
		"@urql/exchange-request-policy": "1.2.0",
		"@urql/exchange-retry": "1.3.0",
		"@urql/svelte": "4.2.2",
		"csv-parse": "5.6.0",
		"flowbite": "2.5.2",
		"flowbite-svelte": "0.47.4",
		"graphql": "16.10.0",
		"graphql-ws": "5.16.0",
		"leaflet": "1.9.4",
		"oidc-client-ts": "3.1.0",
		"svelte-i18n": "4.0.1",
		"tailwind-merge": "2.6.0"
	},
	"lint-staged": {
		"*.{cjs,json,css,scss,htm,html,md,yml,yaml}": "node_modules/.bin/prettier --write",
		"**/!(generated|mock-app)/*.{js,ts}": [
			"eslint --cache --max-warnings 0 --fix"
		],
		"**/!(generated)/*.{js,ts}": [
			"node_modules/.bin/prettier --write"
		],
		"*.svelte": [
			"npm run lint:check:svelte",
			"eslint --cache --max-warnings 0 --fix",
			"node_modules/.bin/prettier --write --plugin prettier-plugin-svelte --plugin prettier-plugin-tailwindcss"
		]
	}
}
