{
	"name": "frontend",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=18.0.0",
		"npm": "^10.0.0"
	},
	"scripts": {
		"dev": "vite dev --host 0.0.0.0",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"lint:check": "npm-run-all --parallel lint:check:**",
		"lint:check:svelte": "svelte-check --fail-on-warnings",
		"lint:check:ts": "tsc --noEmit",
		"lint:check:eslint": "eslint --cache --max-warnings 0 src",
		"lint:fix": "eslint --cache --fix src",
		"generate-types": "graphql-codegen"
	},
	"devDependencies": {
		"@eslint/js": "9.24.0",
		"@graphql-codegen/cli": "5.0.5",
		"@graphql-codegen/typescript": "4.1.6",
		"@graphql-codegen/typescript-operations": "4.6.0",
		"@iconify-json/heroicons": "1.2.2",
		"@sveltejs/adapter-static": "3.0.8",
		"@sveltejs/kit": "2.20.4",
		"@sveltejs/vite-plugin-svelte": "5.0.3",
		"@testing-library/jest-dom": "6.6.3",
		"@testing-library/svelte": "5.2.7",
		"@typescript-eslint/parser": "8.29.0",
		"@vitest/coverage-istanbul": "3.1.1",
		"@vitest/eslint-plugin": "1.1.39",
		"autoprefixer": "10.4.21",
		"eslint": "9.24.0",
		"eslint-config-prettier": "10.1.1",
		"eslint-plugin-jest": "28.11.0",
		"eslint-plugin-svelte": "3.5.1",
		"globals": "16.0.0",
		"jsdom": "26.0.0",
		"npm-run-all": "4.1.5",
		"postcss": "8.5.3",
		"postcss-load-config": "6.0.1",
		"prettier": "3.5.3",
		"prettier-plugin-svelte": "3.3.3",
		"prettier-plugin-tailwindcss": "0.6.11",
		"svelte": "5.25.7",
		"svelte-check": "4.1.5",
		"svelte-eslint-parser": "1.1.2",
		"svelte-preprocess": "6.0.3",
		"tailwindcss": "4.1.3",
		"tslib": "2.8.1",
		"tw-colors": "3.3.2",
		"typescript": "5.8.3",
		"typescript-eslint": "8.29.0",
		"unplugin-icons": "22.1.0",
		"vite": "6.2.5",
		"vitest": "3.1.1"
	},
	"dependencies": {
		"@sentry/sveltekit": "8.55.0",
		"@types/leaflet": "1.9.17",
		"@urql/exchange-request-policy": "1.2.1",
		"@urql/exchange-retry": "1.3.1",
		"@urql/svelte": "4.2.3",
		"@tailwindcss/postcss": "4.1.3",
		"csv-parse": "5.6.0",
		"flowbite": "3.1.2",
		"flowbite-svelte": "0.48.4",
		"graphql": "16.10.0",
		"graphql-ws": "6.0.4",
		"leaflet": "1.9.4",
		"oidc-client-ts": "3.2.0",
		"svelte-i18n": "4.0.1",
		"tailwind-merge": "3.2.0"
	},
	"lint-staged": {
		"*.{cjs,json,css,scss,htm,html,md,yml,yaml}": "node_modules/.bin/prettier --write",
		"**/!(generated|mock-app)/*.{js,ts}": [
			"eslint --cache --max-warnings 0 --fix"
		],
		"**/!(generated)/*.{js,ts}": [
			"node_modules/.bin/prettier --write"
		],
		"*.svelte": [
			"npm run lint:check:svelte",
			"eslint --cache --max-warnings 0 --fix",
			"node_modules/.bin/prettier --write --plugin prettier-plugin-svelte --plugin prettier-plugin-tailwindcss"
		]
	}
}
