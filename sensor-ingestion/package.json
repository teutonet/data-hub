{
	"name": "sensor-ingestion",
	"version": "1.0.0",
	"description": "This project contains the image sources and Helm chart needed to create a Kubernetes deployment for ingesting sensor data and persisting it in various databases.",
	"engines": {
		"node": "^22.0.0",
		"npm": "^10.0.0"
	},
	"scripts": {
		"format:check": "npx prettier . --check",
		"format:fix": "npx prettier . --write"
	},
	"devDependencies": {
		"prettier": "3.5.3",
		"prettier-plugin-svelte": "3.3.3",
		"prettier-plugin-tailwindcss": "0.6.11",
		"npm-run-all": "4.1.5",
		"lint-staged": "15.5.1",
		"husky": "9.1.7"
	},
	"lint-staged": {
		"*.{cjs,json,css,scss,htm,html,md,yml,yaml}": "node_modules/.bin/prettier . --write"
	}
}
