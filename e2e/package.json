{
	"name": "e2e",
	"version": "0.0.1",
	"scripts": {
		"e2e:gen": "npx playwright codegen -b firefox data-hub.local --ignore-https-errors --lang en-US",
		"lint:fix": "eslint --max-warnings 0 --fix --cache test",
		"lint:check": "eslint --max-warnings 0 --cache test"
	},
	"packageManager": "pnpm@12.3.4",
	"dependencies": {
		"@playwright/test": "1.63.0",
		"axios": "1.20.0",
		"playwright": "1.63.0",
		"prometheus-remote-write": "^0.5.0",
		"sharp": "0.35.4"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/node": "24.13.3",
		"eslint": "10.10.0",
		"globals": "17.12.0",
		"typescript-eslint": "8.69.0"
	},
	"keywords": [],
	"author": "",
	"lint-staged": {
		"*.{js,ts}": [
			"eslint --cache --fix",
			"../node_modules/.bin/prettier --write"
		],
		"*.{cjs,json,css,scss,htm,html,md,yml,yaml}": "../node_modules/.bin/prettier --write"
	}
}
